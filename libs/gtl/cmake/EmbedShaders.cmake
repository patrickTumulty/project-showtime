# cmake/embed_shaders.cmake
#
# Run in script mode to generate a header embedding shader sources as
# C string literals:
#
#     cmake -DBASE_DIR=... -DSHADERS="file.vert:VAR_NAME;file.frag:VAR_NAME" \
#           -DOUTPUT=<generated header path> -P cmake/embed_shaders.cmake

if(NOT DEFINED OUTPUT)
    message(FATAL_ERROR "OUTPUT (generated header path) is required")
endif()

if(NOT DEFINED SHADERS)
    message(FATAL_ERROR "SHADERS (comma-separated list of \"filename:VARIABLE_NAME\") is required")
endif()

# Commas survive being passed through a CMake command line; convert to lists.
string(REPLACE "," ";" SHADERS "${SHADERS}")

if(NOT DEFINED BASE_DIR)
    set(BASE_DIR "${CMAKE_CURRENT_LIST_DIR}/../shaders")
endif()

string(APPEND body "// Generated by cmake/embed_shaders.cmake -- DO NOT EDIT.\n"
                   "// Edit the shader source files instead.\n"
                   "#pragma once\n\n")

foreach(entry IN LISTS SHADERS)
    string(REPLACE ":" ";" pair "${entry}")
    list(GET pair 0 shader_file)
    list(GET pair 1 var_name)

    set(input_path "${BASE_DIR}/${shader_file}")
    if(NOT EXISTS "${input_path}")
        message(FATAL_ERROR "Shader file not found: ${input_path}")
    endif()

    file(READ "${input_path}" content)

    # Escape for a C string literal.
    string(REPLACE "\\" "\\\\" content "${content}")
    string(REPLACE "\"" "\\\"" content "${content}")

    # Turn each newline into a literal \n and open a new string segment on
    # its own line for readability.
    string(REPLACE "\n" "\\n\"\n            \"" content "${content}")

    string(APPEND body "static const char *${var_name} = \"${content}\";\n\n")
endforeach()

file(WRITE "${OUTPUT}" "${body}")
